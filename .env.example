# Auto-DDM settings for the OpenAI API.
# Copy this file to .env and put your key on the first line.

# Required. Your OpenAI API key.
OPENAI_API_KEY=your-openai-api-key-here

# Model for the repair agent and the diversity agent. The paper uses gpt-5-mini.
OPENAI_MODEL=gpt-5-mini

# Optional. Base URL of an OpenAI-compatible endpoint. Leave empty for api.openai.com.
OPENAI_BASE_URL=

# Optional. Sampling temperature. The paper runs use 0.3.
# If the model accepts only its default temperature, the code stops sending this value.
OPENAI_TEMPERATURE=0.3
